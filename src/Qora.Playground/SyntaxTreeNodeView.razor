@using Qora.Compiler

@* Renders Qora's immutable parser-independent syntax projection. *@
<li>
    <span class="tree-label @(Node.Kind == SyntaxTreeNodeKind.Terminal ? "tree-leaf" : "tree-nt")">@Node.Label</span>
    @if (!Node.Children.IsDefaultOrEmpty)
    {
        <ul>
            @foreach (var child in Node.Children)
            {
                <SyntaxTreeNodeView Node="child" />
            }
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public SyntaxTreeNode Node { get; set; } = default!;
}
