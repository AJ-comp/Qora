@page "/"
@using Qora.Compiler

<PageTitle>Qora Playground</PageTitle>

<div class="playground">

    <header class="playground-header">
        <h1 class="playground-title">Qora Playground</h1>
        <p class="playground-description">
            Q# 스타일 양자 토이 언어 <strong>Qora</strong>을 브라우저에서 바로 파싱·변환해보세요 —
            <code>operation Foo(q: Qubit[])</code> · <code>호출 Foo(q)</code> · <code>q.Count</code> · <code>use … Qubit[n]</code> ·
            <code>const/var/int</code> · <code>bool[] / int[] / float[] / bit[] / angle[]</code> · <code>H / X / CNOT / S / T / CZ / SWAP / CCX</code> ·
            <code>Rx / Ry / Rz (회전, pi/2)</code> ·
            <code>var r: bit = M(…)</code> · <code>for … in</code> ·
            <code>if</code> · <code>while</code> · <code>repeat … until</code>
        </p>
    </header>

    <div class="playground-grid">

        @* --- input --- *@
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Qora 코드</BbCardTitle>
                <BbCardDescription>프로그램을 입력하고 Run을 누르세요.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <div style="height: 340px; border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden;">
                    <StandaloneCodeEditor @ref="_editor" Id="qora-editor"
                                          ConstructionOptions="EditorOptions"
                                          OnDidInit="OnEditorInit" />
                </div>
            </BbCardContent>
            <BbCardFooter>
                <div class="playground-actions">
                    <BbButton OnClick="Run">Run</BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="LoadBell">예제 불러오기</BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="Clear">지우기</BbButton>
                </div>
            </BbCardFooter>
        </BbCard>

        @* --- output --- *@
        <BbCard>
            <BbCardHeader>
                <div class="playground-result-heading">
                    <BbCardTitle>결과</BbCardTitle>
                    @if (_result is not null)
                    {
                        <BbBadge Variant="@(_result.Succeeded ? BadgeVariant.Default : BadgeVariant.Destructive)">
                            @(_result.Succeeded ? "ACCEPTED" : "REJECTED")
                        </BbBadge>
                    }
                </div>
                <BbCardDescription>파싱 결과와 파스 트리</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (_result is null)
                {
                    <p class="playground-status">아직 실행 전이에요.</p>
                }
                else
                {
                    @if (!_result.Succeeded)
                    {
                        <div class="playground-diagnostics">
                            <p class="playground-error">
                                @(_result.Diagnostics.Any(d => d.Stage == CompilationStage.Syntax)
                                    ? "파싱 실패 — 문법에 맞지 않아요."
                                    : "컴파일 실패 — 문법은 맞지만 이후 단계에서 오류가 발생했어요.")
                            </p>
                            @if (_result.Diagnostics.Count > 0)
                            {
                                <pre class="playground-output playground-output-wrap">@string.Join("\n", _result.Diagnostics.Select(d => d.Error))</pre>
                            }
                            else
                            {
                                <p class="playground-hint">아래 토큰을 보고 키워드/기호가 맞는지 확인해보세요.</p>
                            }
                        </div>
                    }
                    @if (_result.Sources.EntrySyntax.Ast is not null || _result.Sources.EntrySyntax.ParseTree is not null)
                    {
                        <div class="playground-tabs">
                            <BbButton Size="ButtonSize.Small"
                                      Variant="@(_view == "ast" ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      OnClick='@(() => SetView("ast"))'>AST</BbButton>
                            <BbButton Size="ButtonSize.Small"
                                      Variant="@(_view == "parse" ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      OnClick='@(() => SetView("parse"))'>파스 트리</BbButton>
                        </div>
                        <div class="tree-wrap" style="max-height: 60vh; overflow: auto;">
                            <ul class="tree">
                                @if (_view == "ast" && _result.Sources.EntrySyntax.Ast is not null)
                                {
                                    <SyntaxTreeNodeView Node="_result.Sources.EntrySyntax.Ast!" />
                                }
                                else if (_result.Sources.EntrySyntax.ParseTree is not null)
                                {
                                    <SyntaxTreeNodeView Node="_result.Sources.EntrySyntax.ParseTree!" />
                                }
                            </ul>
                        </div>
                    }
                }
            </BbCardContent>
        </BbCard>
    </div>

    @* --- OpenQASM 3.0 output --- *@
    @if (_result is not null
        && _result.Succeeded
        && !string.IsNullOrEmpty(_result.Targets.OpenQasm?.Text))
    {
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>OpenQASM 3.0</BbCardTitle>
                <BbCardDescription>이 Qora 코드를 OpenQASM 3으로 변환한 결과입니다. 실행 도구에 따라 지원하는 문법과 기능이 다릅니다.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <pre class="playground-output" style="max-height: 40vh">@_result.Targets.OpenQasm!.Text</pre>
            </BbCardContent>
        </BbCard>
    }

    @* --- tokens --- *@
    @if (_result is not null && _result.Sources.EntrySyntax.Tokens.Count > 0)
    {
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>토큰 <span class="playground-token-count">(@(_result.Sources.EntrySyntax.Tokens.Count)개)</span></BbCardTitle>
                <BbCardDescription>각 토큰이 어떤 종류로 인식됐는지</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <div class="playground-token-list">
                    @foreach (var t in _result.Sources.EntrySyntax.Tokens)
                    {
                        <BbBadge Variant="BadgeVariant.Outline" Class="playground-token">
                            @t.Text<span class="playground-token-kind">@t.Type</span>
                        </BbBadge>
                    }
                </div>
            </BbCardContent>
        </BbCard>
    }

</div>

@code {
    private const string BellExample =
        "operation Prepare(q: Qubit[]) {\n    H(q[0]);\n    CNOT(q[0], q[1]);\n    Rz(pi/4, q[1]);\n    Ry(0.5, q[0]);\n}\n\noperation Main() {\n    use q = Qubit[2];\n    Prepare(q);\n    for i in 0..q.Count - 1 {\n        Rx(pi/2, q[i]);\n    }\n    var r: bit = M(q[0]);\n    if (r == 1) {\n        X(q[1]);\n    }\n}";

    private StandaloneCodeEditor _editor = null!;
    private Compilation? _result;
    private string _view = "ast";   // "ast" or "parse"

    private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor editor) =>
        new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "qora",
            Theme = "qora-theme",
            Value = BellExample,
            FontSize = 14,
            ScrollBeyondLastLine = false,
            Minimap = new EditorMinimapOptions { Enabled = false },
            // render hover/suggest tooltips at the page level so they aren't clipped by the
            // bordered wrapper's overflow:hidden when there's no room inside the editor.
            FixedOverflowWidgets = true,
        };

    private async Task OnEditorInit() => await Run();

    private void SetView(string view) => _view = view;

    private async Task Run()
    {
        var code = await _editor.GetValue();
        _result = QoraCompiler.Compile(code);
        StateHasChanged();
    }

    private async Task LoadBell()
    {
        await _editor.SetValue(BellExample);
        await Run();
    }

    private async Task Clear()
    {
        await _editor.SetValue(string.Empty);
        _result = null;
    }
}
